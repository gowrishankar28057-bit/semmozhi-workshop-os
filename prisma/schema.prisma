// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  ORGANIZER
  PARTICIPANT
}

enum WorkshopStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CertificateStatus {
  PENDING
  ISSUED
  REVOKED
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String
  password  String
  role      UserRole   @default(PARTICIPANT)
  avatar    String?
  phone     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  organizer               Organizer?
  workshopParticipations WorkshopParticipant[]
  attendances            Attendance[]
  certificates           Certificate[]

  @@index([email])
  @@index([role])
}

model Organizer {
  id              String   @id @default(cuid())
  userId          String   @unique
  organizationName String
  description     String?
  website         String?
  logo            String?
  phone           String?
  address         String?
  city            String?
  state           String?
  country         String?
  zipCode         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workshops Workshop[]

  @@index([userId])
}

model Workshop {
  id              String          @id @default(cuid())
  title           String
  description     String
  organizerId     String
  status          WorkshopStatus  @default(DRAFT)
  category        String?
  language        String          @default("English")
  startDate       DateTime
  endDate         DateTime
  registrationDeadline DateTime?
  maxParticipants Int?
  minAttendancePercentage Int @default(90)
  certificateTemplate String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  organizer         Organizer              @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  sessions          Session[]
  participants      WorkshopParticipant[]
  announcements     Announcement[]
  resources         Resource[]
  certificates      Certificate[]

  @@index([organizerId])
  @@index([status])
  @@index([startDate])
}

model Session {
  id          String   @id @default(cuid())
  workshopId  String
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  meetingUrl  String?
  location    String?
  sessionNumber Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workshop    Workshop     @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  attendances Attendance[]

  @@index([workshopId])
  @@index([startTime])
  @@unique([workshopId, sessionNumber])
}

model WorkshopParticipant {
  id          String   @id @default(cuid())
  userId      String
  workshopId  String
  registeredAt DateTime @default(now())
  status      String   @default("active")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workshop   Workshop  @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  certificates Certificate[]

  @@unique([userId, workshopId])
  @@index([workshopId])
  @@index([userId])
}

model Attendance {
  id          String   @id @default(cuid())
  userId      String
  sessionId   String
  workshopId  String
  presentAt   DateTime @default(now())
  verifiedAt  DateTime?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  workshop  Workshop  @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId])
  @@index([workshopId])
  @@index([userId])
  @@index([sessionId])
}

model Certificate {
  id              String             @id @default(cuid())
  participantId   String
  workshopId      String
  certificateCode String             @unique
  hash            String             @unique
  qrCode          String?
  status          CertificateStatus  @default(PENDING)
  issuedAt        DateTime?
  verifiedAt      DateTime?
  attendancePercentage Float
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  participant     User             @relation(fields: [participantId], references: [id], onDelete: Cascade)
  workshopParticipant WorkshopParticipant @relation(fields: [participantId, workshopId], references: [userId, workshopId], onDelete: Cascade)
  workshop        Workshop         @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@index([workshopId])
  @@index([participantId])
  @@index([certificateCode])
  @@index([status])
}

model Announcement {
  id          String   @id @default(cuid())
  workshopId  String
  title       String
  content     String
  priority    String   @default("normal")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@index([workshopId])
  @@index([createdAt])
}

model Resource {
  id          String   @id @default(cuid())
  workshopId  String
  title       String
  description String?
  fileUrl     String
  fileType    String
  fileSize    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@index([workshopId])
}
